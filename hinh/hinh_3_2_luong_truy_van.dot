digraph G {
  rankdir=LR; nodesep=0.3; ranksep=0.35;
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5", fontname="Liberation Sans", fontsize=11];
  edge [color="#555555", fontname="Liberation Sans", fontsize=10];
  user [label="Người dùng\n(Streamlit)", shape=ellipse, fillcolor="#e6f4ea", color="#3b8b55"];
  guard [label="Guardrails\n(bao_ve.py)", shape=diamond, fillcolor="#fff7d6", color="#b39b2d"];
  refuse [label="Từ chối /\nđiều hướng", fillcolor="#f2f2f2", color="#888888"];
  chat [label="Chat engine\nviết lại câu hỏi\n(Memory)"];
  router [label="RouterQueryEngine\n(dinh_tuyen.py)", shape=diamond, fillcolor="#fff7d6", color="#b39b2d"];
  sql [label="NLSQL\nbảng products\n(chỉ đọc)"];
  rag [label="Vector + BM25\n-> RRF Top 10\n-> Reranker Top 3"];
  gop [label="Tính trả góp\n(FunctionTool)"];
  llm [label="Gemini sinh câu trả lời\n+ nguồn trích dẫn"];
  user -> guard;
  guard -> refuse [label="chặn"];
  guard -> chat [label="qua"];
  chat -> router;
  router -> sql [label="số liệu"];
  router -> rag [label="tư vấn, chính sách,\nmẹo sử dụng"];
  router -> gop [label="trả góp"];
  sql -> llm; rag -> llm; gop -> user [label="kết quả tính"];
  llm -> user; refuse -> user;
}
