digraph G {
  rankdir=TB; nodesep=0.35; ranksep=0.35;
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5", fontname="Liberation Sans", fontsize=11];
  edge [color="#555555", fontname="Liberation Sans", fontsize=10];
  user [label="Người dùng\n(Streamlit, app.py)", shape=ellipse, fillcolor="#e6f4ea", color="#3b8b55"];
  vl [label="Viết lại câu hỏi\nPROMPT_VIET_LAI\n(6 tin nhắn gần nhất,\nchỉ khi có lịch sử)"];
  rg [label="Lớp 1: regex\n(không gọi LLM)", shape=diamond, fillcolor="#fff7d6", color="#b39b2d"];
  lg [label="Lớp 2: LLM kiểm duyệt\ntấn công? trong phạm vi?", shape=diamond, fillcolor="#fff7d6", color="#b39b2d"];
  refuse [label="Từ chối /\nđiều hướng", fillcolor="#f2f2f2", color="#888888"];
  router [label="RouterQueryEngine\nLLMSingleSelector\n(có thể chọn 2 công cụ)", shape=diamond, fillcolor="#fff7d6", color="#b39b2d"];
  sql [label="tra_cuu_so_lieu\nNLSQL trên products\n(kết nối chỉ đọc)"];
  rag [label="tu_van_va_chinh_sach\n4 nhánh Vector + BM25\nRRF Top 10, Reranker Top 3\nngưỡng 0,10"];
  gop [label="tinh_tra_gop\nLLM trích tham số,\nPython tính"];
  llm [label="Gemini sinh câu trả lời\n+ source_nodes"];
  tc [label="Câu từ chối cố định\n(không gọi LLM)", fillcolor="#f2f2f2", color="#888888"];
  user -> vl -> rg;
  rg -> refuse [label="khớp mẫu"];
  rg -> lg [label="không khớp"];
  lg -> refuse [label="chặn"];
  lg -> router [label="qua"];
  router -> sql [label="số liệu"];
  router -> rag [label="tư vấn, chính sách"];
  router -> gop [label="trả góp"];
  rag -> tc [label="không còn Node"];
  sql -> llm; rag -> llm; gop -> user [label="kết quả tính"];
  llm -> user; refuse -> user; tc -> user;
}
