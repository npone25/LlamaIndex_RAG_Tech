# Sao chép file này thành .env rồi điền giá trị thật. Không commit file .env
GOOGLE_API_KEY=dien_api_key_gemini_cua_ban

# Mô hình Gemini (đổi được mà không sửa code)
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_DU_PHONG=gemini-3.1-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite

# Docker Compose đọc các biến PG_* để tạo PostgreSQL
PG_USER=postgres
PG_PASSWORD=dat_mat_khau_rieng
PG_DB=phone_rag_db
PG_PORT=5432

# Code Python đọc PG_DSN (phải khớp với các biến PG_* ở trên)
# Dạng: postgresql://PG_USER:PG_PASSWORD@localhost:PG_PORT/PG_DB
PG_DSN=postgresql://postgres:dat_mat_khau_rieng@localhost:5432/phone_rag_db

# Chỉ cần khi bật pgAdmin (docker compose --profile tools up -d)
PGADMIN_PASSWORD=
